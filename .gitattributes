# Line-ending policy: LF in the repository, CRLF in the working tree.
# Files on disk stay native Windows CRLF; git stores LF so diffs, merges and
# blame stay clean. `text=auto` (never bare `text`) keeps git's binary
# auto-detection active — bare `text` forces normalization even on files git
# knows are binary, which irreversibly corrupts UTF-16 content on add.
* text=auto eol=crlf

*.cs     text=auto eol=crlf
*.csproj text=auto eol=crlf
*.slnx   text=auto eol=crlf
*.xaml   text=auto eol=crlf
*.json   text=auto eol=crlf
*.md     text=auto eol=crlf
*.txt    text=auto eol=crlf
*.ps1    text=auto eol=crlf
*.iss    text=auto eol=crlf

# Electron port (v5.0). Listed explicitly rather than left to the `*` rule above
# so the policy for these types is stated where someone looks for it.
*.ts     text=auto eol=crlf
*.js     text=auto eol=crlf
*.cjs    text=auto eol=crlf
*.mjs    text=auto eol=crlf
*.html   text=auto eol=crlf
*.css    text=auto eol=crlf
*.svg    text=auto eol=crlf

# Captured telemetry fixtures: byte-exact, no normalization in either direction.
# These are real `typeperf` / `pmset` / `hwmon` output, and the parsers are written
# against their exact bytes — `typeperf` emits a bare \r line before its header, which
# is why the CSV parser splits on /\r?\n/ at all. Let git normalize these and the
# fixture quietly stops covering the case it was captured for. `-text` disables EOL
# conversion without claiming the content is binary, so diffs stay readable.
# Scoped to the captures themselves, not the whole directory — the README beside them is
# ordinary prose and follows the CRLF policy above.
electron/test/fixtures/*.csv -text
# The macOS captures are LF because macOS emits LF, and one of them is delimited by a
# literal TAB (`pmset -g batt`). The `*.txt text=auto eol=crlf` rule above would rewrite
# every one of them to CRLF in the working tree, so a parser written against these bytes
# would be tested against line endings the tool never produces. Same reasoning as the CSVs,
# different platform.
electron/test/fixtures/macos-*.txt -text

# LF for GitHub Actions workflows: release.yml has 4 `shell: bash` steps, and
# CRLF leaks a stray \r into bash variable expansion.
*.yml    text=auto eol=lf
*.yaml   text=auto eol=lf

# Explicit binary rules. Git's auto-detection only looks for a NUL byte in the
# first 8000 bytes, so it fails OPEN on NUL-free binaries (.snk/.pfx keys) —
# those get EOL-mangled on add, which cannot be undone.
*.png  binary
*.ico  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.bmp  binary
*.cur  binary
*.exe  binary
*.dll  binary
*.pdb  binary
*.pfx  binary
*.snk  binary
*.zip  binary
*.msi  binary
*.nupkg binary
*.pdf  binary
*.ttf  binary
*.otf  binary
# bun's legacy lockfile is a NUL-free binary — exactly the case the note above
# describes, where git's auto-detection fails open and EOL-mangles it on add.
# The modern text lockfile is LF-only by bun's own writer; forcing CRLF would
# make every `bun install` dirty the file.
bun.lockb binary
bun.lock  text=auto eol=lf
*.woff binary
*.woff2 binary
