<Project Sdk="Microsoft.NET.Sdk">

  <!-- Generates the ISC-13 translation oracle from the C# providers, for the TypeScript port to
       be diffed against. Deliberately NOT listed in FuzzyClock.slnx: it must not join the
       632-test gate, and `dotnet test` must not start depending on it. Run it explicitly with
       `dotnet run`, passing this csproj via the project flag and Release configuration.

       (The invocation is described rather than pasted because an XML comment may not contain a
       double hyphen, which every dotnet CLI flag has.)

       This project is expected to die with the WPF tree at ISC-31. The golden files it writes
       are the artifact that survives. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FuzzyClock.GoldenGen</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../FuzzyClock.Core/FuzzyClock.Core.csproj" />
  </ItemGroup>

</Project>
