<Project Sdk="Microsoft.NET.Sdk">

  <!-- Emits the TypeScript phrase tables for the v5.0 port by REFLECTING the compiled
       FuzzyClock.Core providers. One job only: move 1,987 LOC of string tables across the
       language boundary without a human retyping them.

       Why reflection and not a source parser, or hands: the tables are the single most
       error-prone part of this port (18 files of nested array literals, six languages,
       non-ASCII throughout), and every kind of copy has a different failure. A human
       mistypes a word. A regex over the C# source mishandles a nested bracket or an escape
       and does it silently. Reflection reads the values the CLR actually built, so the only
       way to get a wrong string here is for the C# itself to hold one.

       Deliberately NOT in FuzzyClock.slnx, same as tools/GoldenGen: neither belongs in the
       632-test gate. Run it explicitly with `dotnet run`, passing this csproj via the project
       flag. (Described rather than pasted because an XML comment may not contain a double
       hyphen, which every dotnet CLI flag has.)

       Its output is verified by the ISC-13 golden files, which were produced by a different
       tool from a different mechanism (GoldenGen calls the providers, TableExport reads their
       fields), so a defect in this exporter shows up as a candidate-set mismatch rather than as
       a port that quietly disagrees with the original.

       Expected to die with the WPF tree at ISC-31. The emitted .ts file is what survives. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FuzzyClock.TableExport</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../FuzzyClock.Core/FuzzyClock.Core.csproj" />
  </ItemGroup>

</Project>
