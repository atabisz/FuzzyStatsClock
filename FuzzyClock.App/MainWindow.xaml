<Window x:Class="FuzzyClock.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FuzzyClock.App"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize">

    <!-- Background="#01000000": alpha=1, RGB=black — near-transparent but hit-testable.
         A fully transparent (alpha=0) background has no hit-test surface, causing mouse
         events to pass through to windows below and breaking right-click. -->
    <Grid Background="#01000000">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Close" Click="CloseMenuItem_Click" />
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- PhraseText: static placeholder for Phase 2 — phrase engine wired in Phase 3.
             DropShadowEffect provides visual definition to compensate for ClearType being
             disabled by Windows DWM on transparent HWND surfaces. -->
        <TextBlock x:Name="PhraseText"
                   Text="half past 3"
                   FontFamily="Segoe UI Light"
                   FontSize="32"
                   Foreground="White"
                   Margin="8">
            <TextBlock.Effect>
                <DropShadowEffect Color="Black"
                                  BlurRadius="6"
                                  ShadowDepth="2"
                                  Opacity="0.8"
                                  Direction="315"
                                  RenderingBias="Quality" />
            </TextBlock.Effect>
        </TextBlock>
    </Grid>
</Window>
