<Window x:Class="FuzzyClock.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FuzzyClock.App"
        xmlns:controls="clr-namespace:FuzzyClock.App.Controls"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        PreviewMouseRightButtonUp="Window_PreviewMouseRightButtonUp">

    <!-- Background="#01000000": alpha=1, RGB=black — near-transparent but hit-testable.
         A fully transparent (alpha=0) background has no hit-test surface, causing mouse
         events to pass through to windows below and breaking right-click. -->
    <Grid Background="#01000000"
          MouseLeftButtonDown="Grid_MouseLeftButtonDown">

        <!-- Permanent black background — sits at the back, always visible -->
        <Border Background="Black"
                CornerRadius="5"
                IsHitTestVisible="False"/>

        <!-- Full-widget backdrop — sits above black background but behind content.
             Background is Transparent normally, set to semi-transparent black on hover.
             IsHitTestVisible="False" prevents intercepting mouse events meant for inner Grid children. -->
        <Border x:Name="BackdropBorder"
                Background="Transparent"
                CornerRadius="5"
                IsHitTestVisible="False"/>

        <!-- Main container Border: Transparent padding wrapper for consistent spacing -->
        <Border Background="Transparent"
                CornerRadius="5"
                Padding="12">
            <!-- Three-row inner Grid: Row 0 = phrase display, Row 1 = date text, Row 2 = stats panel -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: phrase display -->
                <Border x:Name="ContentBorder"
                        Grid.Row="0"
                        Background="Transparent"
                        Padding="0">
                <Grid>
                    <!-- PhraseText: live phrase wired in Phase 3 via SetInitialPhrase() and
                         UpdatePhraseIfChanged(). Text is set in code-behind before Show(). -->
                    <TextBlock x:Name="PhraseText"
                               Text=""
                               FontFamily="Segoe UI Light"
                               FontSize="32"
                               Foreground="White"
                               HorizontalAlignment="Stretch"
                               TextAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="4" Direction="315" ShadowDepth="1" Opacity="0.6" Color="Black" />
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- Split layout container — visible in Split/Expressive text styles.
                         QualifierText: small faded qualifier (e.g. "just after").
                         EmphasisText: large prominent hour word (e.g. "three").
                         Both hidden by default — SetTextStyle activates on style change. -->
                    <StackPanel x:Name="SplitPhrasePanel"
                                Orientation="Vertical"
                                HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock x:Name="QualifierText"
                                   Text=""
                                   FontFamily="Segoe UI Light"
                                   FontSize="20"
                                   Foreground="#8CFFFFFF"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="EmphasisText"
                                   Text=""
                                   FontFamily="Segoe UI Light"
                                   FontSize="44"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="4" Direction="315" ShadowDepth="1" Opacity="0.6" Color="Black" />
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>

                    <!-- DialCanvas: 80x80 analog clock hands — toggled visible in dial mode.
                         Sits in the same inner Grid as PhraseText; both cannot be visible simultaneously.
                         Center = (40,40). Hand X1/Y1 are set from center; X2/Y2 computed via trig in code-behind.
                         Initial X2/Y2 = 0,0 — code-behind UpdateDialDisplay() sets correct values before Show(). -->
                    <Canvas x:Name="DialCanvas"
                            Width="80" Height="80"
                            Visibility="Collapsed">
                        <Line x:Name="HourHand"
                              X1="40" Y1="40" X2="40" Y2="40"
                              Stroke="White" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line x:Name="MinuteHand"
                              X1="40" Y1="40" X2="40" Y2="40"
                              Stroke="White" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>

                    <!-- LcdClockView: seven-segment LCD display — toggled visible in LCD mode.
                         Sits in the same inner Grid as PhraseText/DialCanvas; mutually exclusive.
                         Timer starts/stops automatically via IsVisibleChanged. -->
                    <controls:LcdClockView x:Name="LcdView"
                                           Visibility="Collapsed"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                    <!-- NixieClockView: nixie tube display — toggled visible in Nixie mode.
                         Sits in the same inner Grid as the other displays; mutually exclusive.
                         Manages its own internal DispatcherTimer via IsVisibleChanged. -->
                    <controls:NixieClockView x:Name="NixieView"
                                             Visibility="Collapsed"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Row 1: date display — shown below phrase/dial, above stats panel.
                 Visibility toggled from tray "Show Date". FontSize is 80% of phrase size, set in code-behind.
                 FontFamily is overridden in code-behind to match the active text style (Mono/Literary/Classic).
                 Foreground is set to dimmed accent color in code-behind (ApplyTheme/ApplyDisplayColor).
                 DropShadowEffect matches PhraseText/EmphasisText (locked decision: same shadow treatment). -->
            <Border x:Name="DateBorder"
                    Grid.Row="1"
                    Background="Transparent"
                    Margin="0,8,0,0"
                    Padding="0"
                    Visibility="Visible">
                <TextBlock x:Name="DateText"
                           FontFamily="Segoe UI Light"
                           FontSize="26"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           TextAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="4" Direction="315" ShadowDepth="1" Opacity="0.6" Color="Black" />
                    </TextBlock.Effect>
                </TextBlock>
            </Border>

            <!-- Row 2: stats panel — default Collapsed.
                 Width="180" prevents window-width jitter from SizeToContent=WidthAndHeight
                 when percentage text length changes (e.g. "9%" vs "100%").
                 Visibility=Collapsed (not Hidden) removes all layout space including margin.
                 Phase 9 toggles Visibility and starts/stops _statsTimer. -->
            <StackPanel x:Name="StatsPanel"
                        Grid.Row="2"
                        Width="184"
                        Margin="0,8,0,0"
                        Background="Transparent"
                        Visibility="Collapsed">

                <!-- CPU row -->
                <Grid x:Name="CpuRow" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="CpuLabel" Text="CPU"
                               Foreground="White" FontFamily="Segoe UI Light" FontSize="12"
                               VerticalAlignment="Center" />
                    <Border Grid.Column="1" x:Name="CpuBarTrack"
                            Background="#40FFFFFF" CornerRadius="2" Height="8" VerticalAlignment="Center">
                        <Border x:Name="CpuBar"
                                HorizontalAlignment="Left" Background="White"
                                CornerRadius="2" Height="8" Width="0" />
                    </Border>
                    <TextBlock Grid.Column="2" x:Name="CpuText"
                               Text="0%" Foreground="White" FontFamily="Segoe UI Light" FontSize="12"
                               TextAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <!-- GPU row -->
                <Grid x:Name="GpuRow" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="GpuLabel" Text="GPU"
                               Foreground="White" FontFamily="Segoe UI Light" FontSize="12"
                               VerticalAlignment="Center" />
                    <Border Grid.Column="1" x:Name="GpuBarTrack"
                            Background="#40FFFFFF" CornerRadius="2" Height="8" VerticalAlignment="Center">
                        <Border x:Name="GpuBar"
                                HorizontalAlignment="Left" Background="White"
                                CornerRadius="2" Height="8" Width="0" />
                    </Border>
                    <TextBlock Grid.Column="2" x:Name="GpuText"
                               Text="0%" Foreground="White" FontFamily="Segoe UI Light" FontSize="12"
                               TextAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <!-- MEM row -->
                <Grid x:Name="MemRow" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="MemLabel" Text="MEM"
                               Foreground="White" FontFamily="Segoe UI Light" FontSize="12"
                               VerticalAlignment="Center" />
                    <Border Grid.Column="1" x:Name="MemBarTrack"
                            Background="#40FFFFFF" CornerRadius="2" Height="8" VerticalAlignment="Center">
                        <Border x:Name="MemBar"
                                HorizontalAlignment="Left" Background="White"
                                CornerRadius="2" Height="8" Width="0" />
                    </Border>
                    <TextBlock Grid.Column="2" x:Name="MemText"
                               Text="0%" Foreground="White" FontFamily="Segoe UI Light" FontSize="12"
                               TextAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <!-- PAG row -->
                <Grid x:Name="PagRow" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="PagLabel" Text="PAG"
                               Foreground="White" FontFamily="Segoe UI Light" FontSize="12"
                               VerticalAlignment="Center" />
                    <Border Grid.Column="1" x:Name="PagBarTrack"
                            Background="#40FFFFFF" CornerRadius="2" Height="8" VerticalAlignment="Center">
                        <Border x:Name="PagBar"
                                HorizontalAlignment="Left" Background="White"
                                CornerRadius="2" Height="8" Width="0" />
                    </Border>
                    <TextBlock Grid.Column="2" x:Name="PagText"
                               Text="0%" Foreground="White" FontFamily="Segoe UI Light" FontSize="12"
                               TextAlignment="Right" VerticalAlignment="Center" />
                </Grid>


                <!-- BATT row -->
                <Grid x:Name="BattRow" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="BattLabel" Text="BATT"
                               Foreground="White" FontFamily="Segoe UI Light" FontSize="12"
                               VerticalAlignment="Center" />
                    <Border Grid.Column="1" x:Name="BattBarTrack"
                            Background="#40FFFFFF" CornerRadius="2" Height="8" VerticalAlignment="Center">
                        <Border x:Name="BattBar"
                                HorizontalAlignment="Left" Background="White"
                                CornerRadius="2" Height="8" Width="0" />
                    </Border>
                    <TextBlock Grid.Column="2" x:Name="BattText"
                               Text="0%" Foreground="White" FontFamily="Segoe UI Light" FontSize="12"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

            <!-- Uptime row — child of StatsPanel so it hides with stats.
                 UptimeText.Visibility controls the sub-toggle (same pattern as CpuRow/GpuRow/etc.). -->
            <TextBlock x:Name="UptimeText"
                       Margin="0,2,0,0"
                       Visibility="Visible"
                       FontFamily="Segoe UI Light"
                       FontSize="11"
                       Foreground="White"
                       Text="up —"
                       TextAlignment="Left" />
            </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
