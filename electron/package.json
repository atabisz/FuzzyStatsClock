{
  "name": "fuzzyclock",
  "version": "5.0.0-alpha.0",
  "private": true,
  "description": "FuzzyClock — a fuzzy-time desktop overlay with a live stats panel, rendered as SVG",
  "author": "Alex Tabisz <alex@tabisz.org>",
  "type": "module",
  "main": "dist/main.js",
  "desktopName": "fuzzyclock.desktop",
  "scripts": {
    "build": "bun run build:main && bun run build:preload && bun run build:preload-settings && bun run build:renderer && bun run build:settings && bun run build:assets",
    "build:main": "bun build src/main/main.ts --outfile dist/main.js --target node --external electron",
    "build:preload": "bun build src/preload.ts --outfile dist/preload.cjs --format cjs --target node --external electron",
    "build:preload-settings": "bun build src/preload-settings.ts --outfile dist/preload-settings.cjs --format cjs --target node --external electron",
    "build:renderer": "bun build src/renderer/renderer.ts --outfile dist/renderer.js --target browser",
    "build:settings": "bun build src/renderer/settings/settings.ts --outfile dist/settings.js --target browser",
    "build:assets": "bun scripts/copy-assets.ts",
    "start": "bun run build && bun scripts/start.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "icon": "bun scripts/make-icon.ts",
    "probe:icon": "bun scripts/probe-icon.ts",
    "probe:settings-form": "bun scripts/probe-settings-form.ts",
    "probe:settings-window": "bun run build && bun scripts/probe-settings-window.ts",
    "probe:settings-window:control": "bun run build && bun scripts/probe-settings-window.ts --control",
    "probe:typeperf": "bun scripts/probe-typeperf.ts",
    "probe:cost": "bun scripts/probe-cost.ts",
    "probe:displays": "bun scripts/probe-displays.ts",
    "probe:display": "bun run build && bun scripts/probe-display.ts",
    "probe:size": "bun scripts/probe-size.ts",
    "probe:shell": "bun run build && bun scripts/probe-shell.ts",
    "probe:fade": "bun run build && bun scripts/probe-fade.ts",
    "probe:pixels": "bun scripts/probe-pixels.ts",
    "probe:pixels-x11": "bun scripts/probe-pixels-x11.ts",
    "probe:altflags": "bun scripts/altflags-x11.ts",
    "probe:battery": "bun scripts/probe-battery.ts",
    "probe:cpu-counter": "bun scripts/probe-cpu-counter.ts",
    "probe:autolaunch": "bun scripts/probe-autolaunch.ts",
    "probe:launchd": "bun scripts/probe-launchd.ts",
    "probe:mac-focus": "bun run build && bun scripts/probe-mac-focus.ts",
    "probe:update": "bun scripts/probe-update.ts",
    "dist:win": "bun run build && electron-builder --win --publish never",
    "dist:mac": "bun run build && electron-builder --mac --publish never",
    "dist:linux": "bun run build && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^24.0.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.0"
  }
}
